/* ============================================================
 * SWDM Design System · QSS 2.0 · DARK overlay
 * 令牌定义见 docs/design/design_tokens.md（单一事实来源）
 * 本文件叠加在 swdm/gui/styles.py DARK_QSS 之后（级联：后定义胜出）
 * 主题：canvas 深一档浮起卡片（Steam 路线）+ 蓝紫操作色 + Steam 蓝链接色
 * ============================================================ */

/* ==================== 画布与表面 ==================== */
/* canvas 深一档：卡片浮起的前提（1.x 为 #1e1e22，与面板仅 5% 明度差） */
QMainWindow, QWidget#central { background-color: #16161C; }
QWidget#swdmSidebar { background-color: #1A1A20; border-right: 1px solid #2B2B33; }

/* 滚动区视口透明：QSS 层无法可靠关闭 autoFillBackground（见
 * design_system.prepare_scroll_area 的注释），内容件透明在代码侧处理。
 * 本文件不设置视口规则——QScrollArea { background: transparent } 会让
 * 视口解析成实色黑，已实测排除。 */

/* ==================== 卡片（workshop 试点对象名） ==================== */
QWidget#swdmCard {
    background-color: #1E1E24;
    border: 1px solid #2E2E37;
    border-radius: 8px;
}
QWidget#swdmCard:hover {
    background-color: #25252D;
    border: 1px solid #4A4A57;
}
#cardTitle { font-weight: 600; font-size: 13px; color: #E8EAF0; background: transparent; }
QWidget#swdmCard:hover #cardTitle { color: #F2F4FA; }
#cardMeta { color: #9AA3AF; font-size: 11px; background: transparent; }
#cardTags { color: #66C0F4; font-size: 11px; background: transparent; }
#cardThumb {
    background-color: #26262E;
    border: 1px solid #2B2B33;
    border-radius: 3px;
}

/* 通用卡片容器（2.0 迁移用：QFrame#swdmCardFrame） */
QFrame#swdmCardFrame {
    background-color: #1E1E24;
    border: 1px solid #2E2E37;
    border-radius: 8px;
}
QFrame#swdmCardFrame:hover {
    background-color: #25252D;
    border: 1px solid #4A4A57;
}

/* ==================== 标签页 ==================== */
/* pane = 画布色：内容区整体深一档，卡片 #1E1E24 浮起（Steam 路线） */
QTabWidget::pane { border: 1px solid #2B2B33; background: #16161C; border-radius: 8px; top: -1px; }
QTabBar { background: transparent; }
QTabBar::tab {
    background: #1E1E24; color: #9AA3AF;
    padding: 8px 18px; border: 1px solid #2B2B33;
    border-bottom: none; border-top-left-radius: 6px; border-top-right-radius: 6px;
    margin-right: 2px; min-width: 24px;
}
QTabBar::tab:selected { background: #7C5CFF; color: #FFFFFF; border-color: #7C5CFF; }
QTabBar::tab:hover:!selected { background: #25252D; color: #D5DAE2; border-color: #3A3A45; }
QTabBar::tab:selected:hover { background: #8F74FF; }

/* ==================== 输入 / 列表 / 表格 / 下拉 ==================== */
QLineEdit, QTextEdit, QPlainTextEdit, QListWidget, QTableWidget, QTreeWidget,
QComboBox, QSpinBox {
    background: #26262E; color: #E8EAF0; border: 1px solid #3A3A45; border-radius: 6px;
    selection-background-color: #32285E; selection-color: #E8EAF0;
    padding: 4px 6px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QListWidget:focus,
QTableWidget:focus, QTreeWidget:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #7C5CFF;
    background: #282832;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover { border: 1px solid #4A4A57; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView {
    background: #26262E; border: 1px solid #3A3A45; border-radius: 6px;
    selection-background-color: #7C5CFF; selection-color: #FFFFFF;
    outline: 0; padding: 2px;
}
QSpinBox::up-button, QSpinBox::down-button { background: transparent; border: none; width: 16px; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background: #25252D; }
QTableWidget::item, QListWidget::item { padding: 4px; border-radius: 5px; }
QListWidget::item:hover, QTableWidget::item:hover { background: #25252D; }
QListWidget::item:selected, QTableWidget::item:selected,
QTreeWidget::item:selected { background: #32285E; color: #E8EAF0; }
QHeaderView::section { background: #1E1E24; color: #9AA3AF; padding: 6px 8px;
    border: none; border-bottom: 1px solid #3A3A45; border-right: 1px solid #26262E;
    min-height: 24px; }
QHeaderView::section:hover { background: #25252D; color: #D5DAE2; }
QHeaderView::section:pressed { background: #1E1E24; }

/* ==================== 按钮（分级 + 轻渐变深度） ==================== */
QPushButton {
    color: white; border: none; padding: 7px 16px;
    border-radius: 6px; font-weight: 500;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #8364FF, stop:1 #7458F5);
}
QPushButton:hover { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #9176FF, stop:1 #7F61F8); }
QPushButton:pressed { background: #6A48F0; }
QPushButton:disabled { background: #35353D; color: #6E757F; }
QPushButton[secondary="true"] {
    background: #25252D; color: #D5DAE2; border: 1px solid #3A3A45;
}
QPushButton[secondary="true"]:hover { background: #2B2B34; border: 1px solid #4A4A57; }
QPushButton[secondary="true"]:pressed { background: #1E1E24; }
QPushButton[danger="true"] { background: #F04747; }
QPushButton[danger="true"]:hover { background: #F46060; }
QPushButton[danger="true"]:pressed { background: #D63C3C; }

/* ==================== 进度条 ==================== */
QProgressBar { border: 1px solid #3A3A45; border-radius: 6px; background: #1A1A20;
    height: 14px; text-align: center; color: #E8EAF0; font-size: 10px; }
QProgressBar::chunk { background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
    stop:0 #8364FF, stop:1 #4A9BFF); border-radius: 5px; }
QProgressBar[status="done"]::chunk { background: #43B581; border-radius: 5px; }
QProgressBar[status="failed"]::chunk { background: #F04747; border-radius: 5px; }
QProgressBar[status="done"] { border: 1px solid #2F6B56; }
QProgressBar[status="failed"] { border: 1px solid #7A2E2E; }

/* ==================== 复选 / 单选 ==================== */
QCheckBox, QRadioButton { color: #E8EAF0; spacing: 6px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 15px; height: 15px; border-radius: 4px;
    border: 1px solid #4A4A55; background: #26262E;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border: 1px solid #8F74FF; }
QCheckBox::indicator:checked { background: #7C5CFF; border: 1px solid #8F74FF; }
QRadioButton::indicator { border-radius: 8px; }
QRadioButton::indicator:checked { background: #7C5CFF; border: 1px solid #8F74FF; }

/* ==================== 分组框 / 标签 ==================== */
QGroupBox { border: 1px solid #3A3A45; border-radius: 8px; margin-top: 12px;
    padding-top: 12px; color: #9AA3AF; background: transparent; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left;
    left: 10px; padding: 0 6px; background: transparent; }

/* ==================== 滚动条 ==================== */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #3D3D47; border-radius: 5px; min-height: 24px;
    border: 1px solid rgba(0,0,0,80); }
QScrollBar::handle:vertical:hover { background: #4D4D59; }
QScrollBar::handle:vertical:pressed { background: #5C5C68; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0; background: transparent; border: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: #3D3D47; border-radius: 5px; min-width: 24px;
    border: 1px solid rgba(0,0,0,80); }
QScrollBar::handle:horizontal:hover { background: #4D4D59; }
QScrollBar::handle:horizontal:pressed { background: #5C5C68; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0; background: transparent; border: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

/* ==================== 状态栏 / 菜单 / 工具按钮 / 提示 ==================== */
/* QMenuBar：1.x 无规则而画亮色 palette，补齐画布色 + 底部分隔线 */
QMenuBar { background: #16161C; color: #9AA3AF; border-bottom: 1px solid #2B2B33; }
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background: #25252D; color: #E8EAF0; }
QStatusBar { background: #121218; color: #9AA3AF; border-top: 1px solid #2B2B33; }
QStatusBar::item { border: none; }
QMenu { background: #26262E; color: #E8EAF0; border: 1px solid #3A3A45;
    border-radius: 8px; padding: 4px; }
QMenu::item { padding: 6px 18px; border-radius: 5px; }
QMenu::item:selected { background: #7C5CFF; color: #FFFFFF; }
QMenu::separator { height: 1px; background: #3A3A45; margin: 4px 8px; }
QSplitter::handle { background: #2B2B33; }
QToolButton { background: transparent; color: #9AA3AF; padding: 5px; border-radius: 5px; }
QToolButton:hover { background: #25252D; color: #E8EAF0; }
QToolTip { background: #26262E; color: #E8EAF0; border: 1px solid #3A3A45;
    border-radius: 6px; padding: 4px 6px; }
