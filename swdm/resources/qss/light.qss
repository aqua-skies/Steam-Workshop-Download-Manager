/* ============================================================
 * SWDM Design System · QSS 2.0 · LIGHT overlay
 * 令牌定义见 docs/design/design_tokens.md（单一事实来源）
 * 本文件叠加在 swdm/gui/styles.py LIGHT_QSS 之后（级联：后定义胜出）
 * 主题：白卡浮于浅灰画布（PCL2 白卡 + Steam 明度差浮起）
 * 链接色深化至 #1F7EB8（≥4.5:1，原 #66C0F4 在白底仅 2.4:1）
 * ============================================================ */

/* ==================== 画布与表面 ==================== */
QMainWindow, QWidget#central { background-color: #F2F3F6; }
QWidget#swdmSidebar { background-color: #E9EBEF; border-right: 1px solid #DDE1E6; }

/* 滚动区视口透明：QSS 层无法可靠关闭 autoFillBackground（见
 * design_system.prepare_scroll_area 的注释），内容件透明在代码侧处理。 */

/* ==================== 卡片（workshop 试点对象名） ==================== */
QWidget#swdmCard {
    background-color: #FFFFFF;
    border: 1px solid #E3E6EB;
    border-radius: 8px;
}
QWidget#swdmCard:hover {
    background-color: #F7F8FA;
    border: 1px solid #B6BCC5;
}
#cardTitle { font-weight: 600; font-size: 13px; color: #23272E; background: transparent; }
QWidget#swdmCard:hover #cardTitle { color: #1A1E24; }
#cardMeta { color: #5A6169; font-size: 11px; background: transparent; }
#cardTags { color: #1F7EB8; font-size: 11px; background: transparent; }
#cardThumb {
    background-color: #EDEFF2;
    border: 1px solid #DDE1E6;
    border-radius: 3px;
}

/* 通用卡片容器（2.0 迁移用：QFrame#swdmCardFrame） */
QFrame#swdmCardFrame {
    background-color: #FFFFFF;
    border: 1px solid #E3E6EB;
    border-radius: 8px;
}
QFrame#swdmCardFrame:hover {
    background-color: #F7F8FA;
    border: 1px solid #B6BCC5;
}

/* ==================== 标签页 ==================== */
/* pane = 画布色：内容区浅灰，白卡 #FFFFFF 浮起（PCL2 白卡路线） */
QTabWidget::pane { border: 1px solid #DDE1E6; background: #F2F3F6; border-radius: 8px; top: -1px; }
QTabBar { background: transparent; }
QTabBar::tab {
    background: #FFFFFF; color: #5A6169;
    padding: 8px 18px; border: 1px solid #DDE1E6;
    border-bottom: none; border-top-left-radius: 6px; border-top-right-radius: 6px;
    margin-right: 2px; min-width: 24px;
}
QTabBar::tab:selected { background: #6D4AFF; color: #FFFFFF; border-color: #6D4AFF; }
QTabBar::tab:hover:!selected { background: #F2F3F6; color: #23272E; border-color: #C8CCD2; }
QTabBar::tab:selected:hover { background: #7D5CFF; }

/* ==================== 输入 / 列表 / 表格 / 下拉 ==================== */
QLineEdit, QTextEdit, QPlainTextEdit, QListWidget, QTableWidget, QTreeWidget,
QComboBox, QSpinBox {
    background: #FFFFFF; color: #23272E; border: 1px solid #C8CCD2; border-radius: 6px;
    selection-background-color: #E7E0FB; selection-color: #23272E;
    padding: 4px 6px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QListWidget:focus,
QTableWidget:focus, QTreeWidget:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #6D4AFF;
    background: #FDFDFF;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover { border: 1px solid #B6BCC5; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView {
    background: #FFFFFF; border: 1px solid #C8CCD2; border-radius: 6px;
    selection-background-color: #6D4AFF; selection-color: #FFFFFF;
    outline: 0; padding: 2px;
}
QSpinBox::up-button, QSpinBox::down-button { background: transparent; border: none; width: 16px; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background: #F2F3F6; }
QTableWidget::item, QListWidget::item { padding: 4px; border-radius: 5px; }
QListWidget::item:hover, QTableWidget::item:hover { background: #F2F3F6; }
QListWidget::item:selected, QTableWidget::item:selected { background: #E7E0FB; color: #23272E; }
QHeaderView::section { background: #FFFFFF; color: #5A6169; padding: 6px 8px;
    border: none; border-bottom: 1px solid #DDE1E6; border-right: 1px solid #EDEFF2;
    min-height: 24px; }
QHeaderView::section:hover { background: #F2F3F6; color: #23272E; }
QHeaderView::section:pressed { background: #E9EBEF; }

/* ==================== 按钮（分级 + 轻渐变深度） ==================== */
QPushButton {
    color: white; border: none; padding: 7px 16px;
    border-radius: 6px; font-weight: 500;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #7B5AFF, stop:1 #6741F2);
}
QPushButton:hover { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #8B6AFF, stop:1 #7250FA); }
QPushButton:pressed { background: #5B3CE0; }
QPushButton:disabled { background: #C8CCD2; color: #8A8F96; }
QPushButton[secondary="true"] {
    background: #F2F3F6; color: #23272E; border: 1px solid #C8CCD2;
}
QPushButton[secondary="true"]:hover { background: #E9EBEF; border: 1px solid #B6BCC5; }
QPushButton[secondary="true"]:pressed { background: #DDE1E6; }
QPushButton[danger="true"] { background: #D63C3C; }
QPushButton[danger="true"]:hover { background: #E04848; }
QPushButton[danger="true"]:pressed { background: #C03030; }

/* ==================== 进度条 ==================== */
QProgressBar { border: 1px solid #C8CCD2; border-radius: 6px; background: #E9EBEF;
    height: 14px; text-align: center; color: #23272E; font-size: 10px; }
QProgressBar::chunk { background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
    stop:0 #7B5AFF, stop:1 #6FA8FF); border-radius: 5px; }
QProgressBar[status="done"]::chunk { background: #2F9E6B; border-radius: 5px; }
QProgressBar[status="failed"]::chunk { background: #D63C3C; border-radius: 5px; }
QProgressBar[status="done"] { border: 1px solid #9ED3BA; }
QProgressBar[status="failed"] { border: 1px solid #E0A0A0; }

/* ==================== 复选 / 单选 ==================== */
QCheckBox, QRadioButton { color: #23272E; spacing: 6px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 15px; height: 15px; border-radius: 4px;
    border: 1px solid #B6BCC5; background: #FFFFFF;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border: 1px solid #7D5CFF; }
QCheckBox::indicator:checked { background: #6D4AFF; border: 1px solid #7D5CFF; }
QRadioButton::indicator { border-radius: 8px; }
QRadioButton::indicator:checked { background: #6D4AFF; border: 1px solid #7D5CFF; }

/* ==================== 分组框 ==================== */
QGroupBox { border: 1px solid #DDE1E6; border-radius: 8px; margin-top: 12px;
    padding-top: 12px; color: #5A6169; background: transparent; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left;
    left: 10px; padding: 0 6px; background: transparent; }

/* ==================== 滚动条 ==================== */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #C8CCD2; border-radius: 5px; min-height: 24px;
    border: 1px solid rgba(0,0,0,25); }
QScrollBar::handle:vertical:hover { background: #AAB1BA; }
QScrollBar::handle:vertical:pressed { background: #98A0AA; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; border: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: #C8CCD2; border-radius: 5px; min-width: 24px;
    border: 1px solid rgba(0,0,0,25); }
QScrollBar::handle:horizontal:hover { background: #AAB1BA; }
QScrollBar::handle:horizontal:pressed { background: #98A0AA; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; border: none; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

/* ==================== 状态栏 / 菜单 / 工具按钮 / 提示 ==================== */
/* QMenuBar：1.x 无规则而画默认 palette，补齐画布色 + 底部分隔线 */
QMenuBar { background: #F2F3F6; color: #5A6169; border-bottom: 1px solid #DDE1E6; }
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background: #E3E6EB; color: #23272E; }
QStatusBar { background: #E9EBEF; color: #5A6169; border-top: 1px solid #DDE1E6; }
QStatusBar::item { border: none; }
QMenu { background: #FFFFFF; color: #23272E; border: 1px solid #C8CCD2;
    border-radius: 8px; padding: 4px; }
QMenu::item { padding: 6px 18px; border-radius: 5px; }
QMenu::item:selected { background: #6D4AFF; color: #FFFFFF; }
QMenu::separator { height: 1px; background: #DDE1E6; margin: 4px 8px; }
QSplitter::handle { background: #DDE1E6; }
QToolButton { background: transparent; color: #5A6169; padding: 5px; border-radius: 5px; }
QToolButton:hover { background: #F2F3F6; }
QToolTip { background: #FFFFFF; color: #23272E; border: 1px solid #C8CCD2;
    border-radius: 6px; padding: 4px 6px; }
