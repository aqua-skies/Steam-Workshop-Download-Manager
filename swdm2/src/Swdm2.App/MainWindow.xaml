<Window x:Class="Swdm2.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:chrome="clr-namespace:Swdm2.App.Ui.Chrome"
        mc:Ignorable="d"
        Title="SWDM 2.0" Height="600" Width="900"
        MinWidth="810" MinHeight="470"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="MainShell">
    <!--
      D5.3 窗口 chrome（t2 §2.4）：
      **路线裁决（D5.3 实证修订，A8b 实测纪律）**：原计划"WPF-UI FluentWindow/TitleBar
      简化通道"在无桌面合成沙箱下 UIA 子树为零（三次最小复现实验：去外挂 WindowChrome /
      去 Mica / 去 ExtendsContentIntoTitleBar+TitleBar 均仍零子；plain Window 对照立即恢复
      子树）——FlaUI 真实输入旅程（用户路线①硬约束）不可达。t2 §2.4 已预见此分支，
      任务 fallback 条款"若弃 WPF-UI TitleBar 时启用"=本实现。
      - WindowChrome（声明式缩放命中区 ResizeBorderThickness=8,PCL2 Resizer 同值）：
        保留系统贴靠（Aero Snap/Win11 SnapLayouts）与 DWM 合成阴影（放弃
        AllowsTransparency 路线的核心收益，t2 §2.4 论证表）。
      - 标题栏 48px 自绘：accent400 单端线性渐变皮肤 + logo 图标钮 + 关闭/最小化钮
        （AutomationId 按 t3 §3.2 保留表 Main_Window_Close/Minimize）。
      - WM_NCHITTEST fallback 条款（Chrome/CustomChromeFallback.cs)，默认不挂
        （WindowChrome CaptionHeight 已覆盖主拖拽路径）。
      - Mica 首版不做（纯色 swdm-SurfaceCanvasBrush;讨论组裁决后再上）。
      - MainShell id = t3 §3.2 保留表（启动断言锚点）。
      颜色一律 DynamicResource swdm-*（t2 §1.4 不变量③）。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="48"
                      ResizeBorderThickness="8" CornerRadius="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid Background="{DynamicResource swdm-SurfaceCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/> <!-- D5.9 状态栏 -->
        </Grid.RowDefinitions>
        <!-- 标题栏 48px：皮肤渐变（自绘，始终）+ logo 图标钮 + 关闭/最小化钮（自绘） -->
        <Grid Height="48" Grid.Row="0">
            <!-- 皮肤渐变：accent400 单端 → 透明（t2 §2.4 片段） -->
            <Grid.Background>
                <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                    <GradientStop Color="{DynamicResource swdm-Accent400Color}" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <!-- logo 图标钮（自绘，始终；A7 可靠载体=Button) -->
            <Button x:Name="BtnLogo" HorizontalAlignment="Left" Height="28" Width="28"
                    Margin="12,0,0,0" VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    Background="Transparent" BorderThickness="0"
                    AutomationProperties.AutomationId="Main_Window_Logo">
                <Path Width="16" Height="16" Stretch="Uniform"
                      Fill="{DynamicResource swdm-TextOnAccentBrush}"
                      Data="M8,0 l2,5 5,0 -4,3.5 1.5,5.5 -4.5,-3.5 -4.5,3.5 1.5,-5.5 -4,-3.5 5,0 z"/>
            </Button>
            <!-- 自绘关闭/最小化钮（X 与横线几何沿用 PCL2 path;pcl2 §2.2);
                 WindowChrome.IsHitTestVisibleInChrome 让按钮在 Caption 区可点击。
                 D5.19/t62 instruction①:hover 放大（Scale 1→1.2，PCL2 MyIconButton 手法重写） -->
            <Button x:Name="BtnClose" HorizontalAlignment="Right" Height="28" Width="28"
                    Margin="0,0,12,0" VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    Background="Transparent" BorderThickness="0"
                    RenderTransformOrigin="0.5,0.5"
                    chrome:TitleButtonHover.Enable="True"
                    AutomationProperties.AutomationId="Main_Window_Close"
                    Click="BtnClose_Click">
                <Button.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Button.RenderTransform>
                <Path Width="10" Height="10" Stretch="Uniform"
                      Fill="{DynamicResource swdm-TextOnAccentBrush}"
                      Data="M0,0 l2,-2 3,3 3,-3 2,2 -3,3 3,3 -2,2 -3,-3 -3,3 -2,-2 3,-3 z"/>
            </Button>
            <Button x:Name="BtnMin" HorizontalAlignment="Right" Height="28" Width="28"
                    Margin="0,0,44,0" VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    Background="Transparent" BorderThickness="0"
                    RenderTransformOrigin="0.5,0.5"
                    chrome:TitleButtonHover.Enable="True"
                    AutomationProperties.AutomationId="Main_Window_Minimize"
                    Click="BtnMin_Click">
                <Button.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Button.RenderTransform>
                <Path Width="10" Height="2" Stretch="Fill"
                      Fill="{DynamicResource swdm-TextOnAccentBrush}"
                      Data="M0,0 h10 v2 h-10 z"/>
            </Button>
        </Grid>
        <!-- 导航条：契约 id 保留（t3 §3.2)；侧栏形态=t2 §2.6,D5.x 页面群时改造 -->
        <!--
        导航条（D5.19/t62 整改：用户"找不到下载功能在哪"=入口不明确
        + 英文混杂不专业）:
        - 中文统一 + 高频主入口（主页/下载）=accent 底强调
        - 次级（浏览/选择游戏/库/设置）=中性
        - 契约 id 全保留（t3 §3.2)
        -->
        <StackPanel Orientation="Horizontal" Margin="10,8" Grid.Row="1">
            <Button AutomationProperties.AutomationId="MainShell_Nav_BackButton"
                    Content="‹ 返回" Padding="10,5" Margin="8,0,0,0"
                    Foreground="{DynamicResource swdm-TextPrimaryBrush}"
                    Command="{Binding GoBackCommand}"/>
            <Button AutomationProperties.AutomationId="MainShell_Nav_HomeButton"
                    Content="主页" Padding="14,6" Margin="8,0,0,0" FontWeight="Bold"
                    Foreground="{DynamicResource swdm-TextOnAccentBrush}"
                    Background="{DynamicResource swdm-Accent500Brush}"
                    Command="{Binding NavigateSphereHomeCommand}"/>
            <Button AutomationProperties.AutomationId="MainShell_Nav_DownloadsButton"
                    Content="⬇ 下载" Padding="14,6" Margin="8,0,0,0" FontWeight="Bold"
                    Foreground="{DynamicResource swdm-TextOnAccentBrush}"
                    Background="{DynamicResource swdm-Accent500Brush}"
                    Command="{Binding NavigateDownloadsCommand}"/>
            <Button AutomationProperties.AutomationId="MainShell_Nav_BrowseButton"
                    Content="浏览工坊" Padding="12,5" Margin="8,0,0,0"
                    Foreground="{DynamicResource swdm-TextPrimaryBrush}"
                    Command="{Binding NavigateBrowseCommand}"/>
            <Button AutomationProperties.AutomationId="MainShell_Nav_GameSelectButton"
                    Content="选择游戏" Padding="12,5" Margin="8,0,0,0"
                    Foreground="{DynamicResource swdm-TextPrimaryBrush}"
                    Command="{Binding NavigateGameSelectCommand}"/>
            <Button AutomationProperties.AutomationId="MainShell_Nav_LibraryButton"
                    Content="Mod 库" Padding="12,5" Margin="8,0,0,0"
                    Foreground="{DynamicResource swdm-TextPrimaryBrush}"
                    Command="{Binding NavigateLibraryCommand}"/>
            <Button AutomationProperties.AutomationId="MainShell_Nav_ModDetailButton"
                    Content="Mod 详情（示例）" Padding="12,5" Margin="8,0,0,0"
                    Foreground="{DynamicResource swdm-TextPrimaryBrush}"
                    Command="{Binding NavigateModDetailCommand}"/>
            <Button AutomationProperties.AutomationId="MainShell_Nav_SettingsButton"
                    Content="设置" Padding="12,5" Margin="8,0,0,0"
                    Foreground="{DynamicResource swdm-TextPrimaryBrush}"
                    Command="{Binding NavigateSettingsCommand}"/>
        </StackPanel>
        <!-- PageHost 容器替换（t2 §2.5;PageNavigationService.Attach 时序驱动 110→30ms) -->
        <ContentControl x:Name="PageHost" Grid.Row="2" Margin="10"/>
        <!--
        D5.9 状态栏端点可达性（t48):
        - 三端点芯片（Api/Store/Community:直连/经代理/封禁/不可达+延迟）+代理模式标签
        - 失败引导=HasFailures 时文案+配代理钮（ProxyConfigDialog)
        - id 契约：StatusBar_Connectivity/StatusBar_ProxyMode/StatusBar_Refresh/StatusBar_ProxyConfigure
        - 颜色/字体一律 DynamicResource swdm-*（t2 §1.4 不变量）
        -->
        <Border Grid.Row="3" Background="{DynamicResource swdm-SurfaceCardBrush}"
                BorderBrush="{DynamicResource swdm-SurfaceCanvasBrush}" BorderThickness="0,1,0,0"
                Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource swdm-TextSecondaryBrush}"
                               FontSize="11"
                               AutomationProperties.AutomationId="StatusBar_ProxyMode"
                               Text="{Binding Connectivity.ProxyModeText}"/>
                    <!-- 契约根 id 挂 ItemsControl(UIA control-view 可见；Border/Panel 无 AutomationPeer 不可达） -->
                    <ItemsControl AutomationProperties.AutomationId="StatusBar_Connectivity"
                                  ItemsSource="{Binding Connectivity.Endpoints}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{DynamicResource swdm-TextPrimaryBrush}"
                                               FontSize="11" Text="{Binding Name}"/>
                                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="11"
                                               Foreground="{Binding StatusBrush}"
                                               Text="{Binding ReachText}"/>
                                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource swdm-TextTertiaryBrush}"
                                               Text="{Binding LatencyText}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 失败引导（HasFailures 才可见：GuidanceVisibility） -->
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"
                               Foreground="{DynamicResource swdm-Danger500Brush}"
                               Text="{Binding Connectivity.GuidanceText}"
                               Visibility="{Binding Connectivity.GuidanceVisibility}"/>
                    <Button Content="配置代理" Padding="10,3" FontSize="11"
                            Visibility="{Binding Connectivity.GuidanceVisibility}"
                            Foreground="{DynamicResource swdm-TextOnAccentBrush}"
                            Background="{DynamicResource swdm-Warning500Brush}"
                            Command="{Binding Connectivity.ConfigureProxyCommand}"
                            AutomationProperties.AutomationId="StatusBar_ProxyConfigure"/>
                </StackPanel>
                <Button Grid.Column="1" Content="↻ 刷新" Padding="10,3" FontSize="11"
                        Foreground="{DynamicResource swdm-TextPrimaryBrush}"
                        Command="{Binding Connectivity.RefreshCommand}"
                        AutomationProperties.AutomationId="StatusBar_Refresh"/>
            </Grid>
        </Border>
    </Grid>
</Window>
