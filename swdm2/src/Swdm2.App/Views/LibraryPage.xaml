<pages:PageBase x:Class="Swdm2.App.Views.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:pages="clr-namespace:Swdm2.App.Ui.Pages"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="840">
    <!--
      D5.12 库页（P0 旅程 5 载体；t51):
      - 已下载 mod 列表（标题/AppId/路径/大小）+按游戏分类
      - 打开目录钮（选中行；explorer 打开 WorkshopContent/<appid>/<itemid>)
      - 空态诚实文案（库为空/扫描失败/目录不存在）
      D6.2 更新检查（t59):
      - 检查更新钮（异步不阻塞）+角标 UpdateCount+非阻塞 Hint
      - 下载全部更新钮=1.x 学费：询问才入队，不自动下载
      AutomationId 契约 `<页面>_<语义>`（t3 §3.2)。
      颜色 DynamicResource swdm-*（t2 §1.4 不变量③)。
    -->
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="已下载的 Mod" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource swdm-TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <!-- t59 更新角标：>0 才显示（非阻塞提示） -->
                <Border AutomationProperties.AutomationId="LibraryPage_UpdateBadge"
                        Visibility="{Binding HasUpdates, Converter={StaticResource swdm-BoolToVisibility}}"
                        Background="{DynamicResource swdm-Accent500Brush}"
                        CornerRadius="8" Margin="8,0,0,0" Padding="6,1">
                    <TextBlock Text="{Binding UpdateCount}" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource swdm-TextOnAccentBrush}"/>
                </Border>
            </StackPanel>
            <Button Grid.Column="1" AutomationProperties.AutomationId="LibraryPage_CheckUpdatesButton"
                    Content="检查更新" Padding="12,4" Margin="6,0,0,0"
                    Command="{Binding CheckForUpdatesCommand}"
                    Foreground="{DynamicResource swdm-TextOnAccentBrush}"
                    Background="{DynamicResource swdm-Accent500Brush}"/>
            <Button Grid.Column="2" AutomationProperties.AutomationId="LibraryPage_RefreshButton"
                    Content="刷新" Padding="12,4" Margin="6,0,0,0"
                    Command="{Binding RefreshCommand}"
                    Foreground="{DynamicResource swdm-TextOnAccentBrush}"
                    Background="{DynamicResource swdm-Accent500Brush}"/>
        </Grid>

        <TextBlock DockPanel.Dock="Top" AutomationProperties.AutomationId="LibraryPage_EmptyHint"
                   Text="{Binding EmptyHint}" FontSize="12" Margin="0,0,0,8"
                   Foreground="{DynamicResource swdm-TextTertiaryBrush}"/>

        <!-- t59 更新提示（非阻塞 Hint;有内容才显示） -->
        <TextBlock DockPanel.Dock="Top" AutomationProperties.AutomationId="LibraryPage_UpdateHint"
                   Text="{Binding UpdateHint}" FontSize="12" Margin="0,0,0,8"
                   Visibility="{Binding HasUpdateHint, Converter={StaticResource swdm-BoolToVisibility}}"
                   Foreground="{DynamicResource swdm-WarningBrush}"/>

        <!-- t59 下载全部更新（询问手势；候选>0 才可用） -->
        <Button DockPanel.Dock="Top" AutomationProperties.AutomationId="LibraryPage_EnqueueAllUpdatesButton"
                Content="下载全部更新" Padding="12,4" Margin="0,0,0,10" HorizontalAlignment="Left"
                Command="{Binding EnqueueAllUpdatesCommand}"
                Foreground="{DynamicResource swdm-TextOnAccentBrush}"
                Background="{DynamicResource swdm-Accent500Brush}"/>

        <Button DockPanel.Dock="Top" AutomationProperties.AutomationId="LibraryPage_OpenDirectoryButton"
                Content="打开目录" Padding="12,4" Margin="0,0,0,10" HorizontalAlignment="Left"
                Command="{Binding OpenDirectoryCommand}"
                Foreground="{DynamicResource swdm-TextOnAccentBrush}"
                Background="{DynamicResource swdm-Accent500Brush}"/>

        <ListBox AutomationProperties.AutomationId="LibraryPage_ItemList_Items"
                 ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.AutomationId"
                            Value="LibraryPage_Item"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="4,2"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" AutomationProperties.AutomationId="LibraryPage_Item_TitleText"
                                   Text="{Binding Title}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource swdm-TextPrimaryBrush}"/>
                        <!-- t59 行级更新标记（bool→可见性；内置转换器） -->
                        <TextBlock Grid.Column="1" AutomationProperties.AutomationId="LibraryPage_Item_UpdateMark"
                                   Text="更新" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                   Visibility="{Binding HasUpdate, Converter={StaticResource swdm-BoolToVisibility}}"
                                   Foreground="{DynamicResource swdm-Accent500Brush}"/>
                        <TextBlock Grid.Column="2" AutomationProperties.AutomationId="LibraryPage_Item_AppIdText"
                                   Text="{Binding AppIdText}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource swdm-TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="3" AutomationProperties.AutomationId="LibraryPage_Item_SizeText"
                                   Text="{Binding SizeText}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource swdm-TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="4" AutomationProperties.AutomationId="LibraryPage_Item_PathText"
                                   Text="{Binding RelativePath}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource swdm-TextTertiaryBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</pages:PageBase>