<pages:PageBase x:Class="Swdm2.App.Views.GameSelectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:pages="clr-namespace:Swdm2.App.Ui.Pages"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="840">
    <!--
      D5.4 游戏选择页（t2 §2.5;1.x 学费三 bug 防呆见 GameSelectPageViewModel）。
      AutomationId 契约=t3 §3.2 `<页面>_<语义>`（FlaUI 双语命中旅程锚点）。
      候选 ListBox 绑单一 ObservableCollection 实例=原地更新（无重绘闪烁）。
      颜色一律 DynamicResource swdm-*（t2 §1.4 不变量③）。
    -->
    <StackPanel Margin="16">
        <TextBlock Text="选择游戏" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource swdm-TextPrimaryBrush}"
                   Margin="0,0,0,12"/>
        <TextBox AutomationProperties.AutomationId="GameSelectPage_SearchBox"
                 Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="SearchBox_KeyDown"
                 Padding="10,8" FontSize="14" Margin="0,0,0,4"/>
        <!-- 即时反馈状态（输入即刻变化，不等网络） -->
        <TextBlock AutomationProperties.AutomationId="GameSelectPage_StatusHint"
                   Text="{Binding StatusHint}" FontSize="12"
                   Foreground="{DynamicResource swdm-TextSecondaryBrush}"
                   Margin="0,0,0,8"/>
        <!-- 候选列表：原地更新（集合实例不变，ItemsControl 容器复用） -->
        <ListBox AutomationProperties.AutomationId="GameSelectPage_SuggestionList"
                 ItemsSource="{Binding Suggestions}"
                 MouseDoubleClick="SuggestionList_MouseDoubleClick"
                 Height="220" Margin="0,0,0,12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource swdm-TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" · " Foreground="{DynamicResource swdm-TextTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Id}" FontSize="12"
                                   Foreground="{DynamicResource swdm-TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button AutomationProperties.AutomationId="GameSelectPage_ConfirmButton"
                Content="确认选择"
                Command="{Binding ConfirmCommand}"
                Padding="20,8" FontSize="14" HorizontalAlignment="Left"
                Foreground="{DynamicResource swdm-TextOnAccentBrush}"
                Background="{DynamicResource swdm-Accent500Brush}"/>
    </StackPanel>
</pages:PageBase>
