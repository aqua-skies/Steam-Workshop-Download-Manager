<Application x:Class="Swdm2.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Swdm2.App">
    <!-- 主题字典单点合并（架构 A3 / t2 §1.1）：
         Common + Accent 主题无关先合并，主题字典（Dark 默认=1.x 品牌延续）最后合并。
         切换 = ThemeService 换主题字典条目（无闪烁，全树 DynamicResource 立即重应用）。
         键名一律 swdm- 前缀防第三方冲突。 -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ui/Themes/Common.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ui/Themes/Accent.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Ui/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
