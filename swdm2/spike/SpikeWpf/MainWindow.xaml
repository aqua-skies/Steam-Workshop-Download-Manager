<ui:FluentWindow x:Class="Swdm2.Spike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:spike="clr-namespace:Swdm2.Spike.Controls"
        Title="SWDM 2.0 Spike — WPF-UI 4.3.0 + FlaUI 5.0.0"
        AutomationProperties.AutomationId="MainWindow"
        Width="920" Height="640"
        MinWidth="760" MinHeight="500"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="SpikeTitleBar" Grid.Row="0" Title="SWDM 2.0 Spike 基座实证"
                     AutomationProperties.AutomationId="SpikeTitleBar" />

        <Grid Grid.Row="1" Margin="18,8,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左列：WPF-UI 原生控件 ===== -->
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,12">
                <ui:TextBox x:Name="SpikeSearchBox" Width="300" Margin="0,0,8,0"
                            PlaceholderText="搜索 mod（中文输入测试）"
                            AutomationProperties.AutomationId="SpikeSearchBox" />
                <ui:Button x:Name="SpikeSearchButton" Content="搜索"
                           Appearance="Primary" Click="SpikeSearchButton_Click"
                           AutomationProperties.AutomationId="SpikeSearchButton" />
            </StackPanel>

            <ui:ListView x:Name="SpikeResultList" Grid.Row="1" Grid.Column="0"
                         AutomationProperties.AutomationId="SpikeResultList"
                         BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Margin="8,6" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ui:ListView>

            <!-- ===== 右列：WPF-UI Card + 自绘 Card 各一 ===== -->
            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                <ui:Card x:Name="SpikeWpfUiCard" Padding="0" Margin="0,0,0,14"
                         AutomationProperties.AutomationId="SpikeWpfUiCard">
                    <StackPanel Margin="16,12,16,12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Apps24Regular" Margin="0,0,8,0" />
                            <TextBlock Text="WPF-UI Card（基座控件）" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="基座库自带卡片：圆角 + 阴影 + 内容区。" TextWrapping="Wrap" />
                        <ui:Button x:Name="SpikeWpfCardButton" Content="WPF-UI 按钮测试" Margin="0,10,0,0"
                                   Click="SpikeWpfCardButton_Click"
                                   AutomationProperties.AutomationId="SpikeWpfCardButton" />
                    </StackPanel>
                </ui:Card>

                <spike:SwdmCard x:Name="SpikeSelfCard"
                                AutomationProperties.AutomationId="SpikeSelfCard"
                                CardTitle="自绘 SwdmCard（PCL2 三层结构）">
                    <StackPanel Margin="15,40,15,12">
                        <TextBlock Foreground="{DynamicResource swdm-TextPrimaryBrush}"
                                   Text="自绘三层：阴影层（90ms 0.07→0.4 悬停）+ 卡底层 + 内容层，DynamicResource 换主题。"
                                   TextWrapping="Wrap" />
                        <Button Content="打开提示弹窗" Margin="0,10,0,0"
                                Click="SpikeCardButton_Click"
                                AutomationProperties.AutomationId="SpikeCardButton" />
                    </StackPanel>
                </spike:SwdmCard>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
